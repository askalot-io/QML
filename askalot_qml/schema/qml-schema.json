{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Questionnaire Markup Language",
  "version": "2.1.0",
  "type": "object",
  "required": [
    "qmlVersion",
    "questionnaire"
  ],
  "properties": {
    "qmlVersion": {
      "type": "string",
      "description": "Minimum QML schema version (Major.Minor.Patch, compatibility semantics) this document requires. Decoupled from the askalot_qml package version; the canonical current schema version is the top-level 'version' field of this schema, exposed in code as askalot_qml.schema.QML_SCHEMA_VERSION. Advisory today (the loader does not yet gate on it); a loader compatibility gate is a planned follow-up."
    },
    "questionnaire": {
      "type": "object",
      "$ref": "#/$defs/Questionnaire"
    }
  },
  "$defs": {
    "Questionnaire": {
      "type": "object",
      "required": [
        "blocks"
      ],
      "properties": {
        "title": {
          "type": "string"
        },
        "codeInit": {
          "description": "Code block which is executed before the questionnaire is started",
          "$ref": "#/$defs/CodeBlock"
        },
        "precondition": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Condition"
          }
        },
        "postcondition": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Condition"
          }
        },
        "blocks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/Block"
          }
        }
      }
    },
    "Block": {
      "type": "object",
      "required": [
        "id",
        "items"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "enum": [
            "Group",
            "Roster"
          ],
          "default": "Group",
          "description": "Block kind (optional, defaults to 'Group'). 'Group' visits its in-scope items once in canonical (stable-Kahn topological) order; an optional 'count' caps it to the first N eligible items. 'Roster' repeats inner items based on a bitmask iterateOver expression."
        },
        "title": {
          "type": "string"
        },
        "precondition": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Condition"
          }
        },
        "postcondition": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Condition"
          }
        },
        "iterateOver": {
          "type": "string",
          "description": "Roster only: Python expression resolving to an integer bitmask. Set bits whose key appears in 'labels' drive iteration."
        },
        "labels": {
          "$ref": "#/$defs/Labels",
          "description": "Roster only: map of power-of-2 integer keys to display strings; declares the universe of possible iterations."
        },
        "subjectFrom": {
          "type": "string",
          "description": "Roster only (optional): id of an inner item whose per-iteration answer becomes the iteration's display subject (e.g. the name a respondent enters). Falls back to the matching 'labels' entry until that item is answered."
        },
        "count": {
          "type": "integer",
          "minimum": 1,
          "description": "Group only (optional): caps the block to the first N eligible items in canonical order. Omitted means ask all in-scope items. Inner items of a count-capped Group must be independent (no inner item may depend on another inner item of the same Group); the loader and validator enforce this."
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/Item"
          }
        }
      },
      "unevaluatedProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "Roster"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "iterateOver",
              "labels"
            ],
            "not": {
              "required": [
                "count"
              ]
            }
          }
        },
        {
          "if": {
            "anyOf": [
              {
                "properties": {
                  "kind": {
                    "const": "Group"
                  }
                },
                "required": [
                  "kind"
                ]
              },
              {
                "not": {
                  "required": [
                    "kind"
                  ]
                }
              }
            ]
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "iterateOver"
                  ]
                },
                {
                  "required": [
                    "labels"
                  ]
                }
              ]
            }
          }
        }
      ]
    },
    "Item": {
      "type": "object",
      "required": [
        "id",
        "kind"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "enum": [
            "Comment",
            "Question",
            "QuestionGroup",
            "MatrixQuestion"
          ]
        },
        "title": {
          "type": "string"
        },
        "precondition": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Condition"
          }
        },
        "postcondition": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Condition"
          }
        },
        "codeBlock": {
          "description": "Code block which is executed after the item is evaluated",
          "$ref": "#/$defs/CodeBlock"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "Comment"
              }
            }
          },
          "then": {}
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "Question"
              }
            }
          },
          "then": {
            "properties": {
              "input": {
                "$ref": "#/$defs/Input"
              }
            },
            "required": [
              "input"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "QuestionGroup"
              }
            }
          },
          "then": {
            "properties": {
              "questions": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "input": {
                "$ref": "#/$defs/Input"
              }
            },
            "required": [
              "questions",
              "input"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "MatrixQuestion"
              }
            }
          },
          "then": {
            "properties": {
              "rows": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "columns": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "input": {
                "$ref": "#/$defs/Input"
              }
            },
            "required": [
              "rows",
              "columns",
              "input"
            ]
          }
        }
      ]
    },
    "Labels": {
      "type": "object",
      "description": "Map of integer values to labels",
      "propertyNames": {
        "type": "integer"
      },
      "additionalProperties": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "CodeBlock": {
      "description": "Python code block",
      "type": "string"
    },
    "Condition": {
      "type": "object",
      "required": [
        "predicate"
      ],
      "properties": {
        "predicate": {
          "description": "Expression that must be true for the condition to be met (booleans and numbers are automatically converted to strings)",
          "oneOf": [
            {"type": "string"},
            {"type": "boolean"},
            {"type": "number"}
          ]
        },
        "hint": {
          "description": "Message to be displayed if the condition is not met",
          "type": "string"
        }
      }
    },
    "Input": {
      "type": "object",
      "required": [
        "control"
      ],
      "properties": {
        "control": {
          "type": "string",
          "enum": [
            "Switch",
            "Radio",
            "Dropdown",
            "Checkbox",
            "Editbox",
            "Textarea",
            "Slider",
            "Range"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "control": {
                "const": "Switch"
              }
            }
          },
          "then": {
            "properties": {
              "off": {
                "type": "string"
              },
              "on": {
                "type": "string"
              },
              "default": {
                "type": "integer",
                "enum": [0, 1],
                "description": "Default value for the switch: 0 for off, 1 for on"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "control": {
                "const": "Radio"
              }
            }
          },
          "then": {
            "properties": {
              "labels": {
                "$ref": "#/$defs/Labels"
              },
              "default": {
                "type": "integer",
                "description": "Default value for the radio control. Must be one of the keys defined in the labels object."
              }
            },
            "required": [
              "labels"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "control": {
                "const": "Checkbox"
              }
            }
          },
          "then": {
            "properties": {
              "labels": {
                "$ref": "#/$defs/Labels"
              },
              "default": {
                "type": "integer",
                "description": "Default value for the checkbox control. Typically a bit mask of the selected options."
              }
            },
            "required": [
              "labels"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "control": {
                "const": "Dropdown"
              }
            }
          },
          "then": {
            "properties": {
              "labels": {
                "$ref": "#/$defs/Labels"
              },
              "left": {
                "type": "string"
              },
              "right": {
                "type": "string"
              },
              "default": {
                "type": "integer",
                "description": "Default value for the dropdown control. Must be one of the keys defined in the labels object."
              }
            },
            "required": [
              "labels"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "control": {
                "const": "Editbox"
              }
            }
          },
          "then": {
            "properties": {
              "min": {
                "type": "integer",
                "description": "Minimum allowed value"
              },
              "max": {
                "type": "integer",
                "description": "Maximum allowed value"
              },
              "left": {
                "type": "string"
              },
              "right": {
                "type": "string"
              },
              "default": {
                "type": "integer",
                "description": "Default value for the editbox. Must be between min and max (inclusive)."
              }              
            },
            "required": [
              "min",
              "max"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "control": {
                "const": "Textarea"
              }
            }
          },
          "then": {
            "properties": {
              "placeholder": {
                "type": "string",
                "description": "Placeholder text shown when the textarea is empty"
              },
              "maxLength": {
                "type": "integer",
                "description": "Maximum number of characters allowed"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "control": {
                "enum": [
                  "Slider",
                  "Range"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "min": {
                "type": "integer",
                "description": "Minimum allowed value"
              },
              "max": {
                "type": "integer",
                "description": "Maximum allowed value"
              },
              "step": {
                "type": "integer",
                "description": "Step size for the slider"
              },
              "default": {
                "type": "integer",
                "description": "Default value for the slider. Must be between min and max (inclusive)."
              },
              "left": {
                "type": "string"
              },
              "right": {
                "type": "string"
              },
              "labels": {
                "$ref": "#/$defs/Labels"
              }
            },
            "required": [
              "min",
              "max"
            ]
          }
        }
      ]
    }
  }
}